{
  "name": "animatedmodal",
  "version": "3.0.0",
  "description": "animatedModal is a modern TypeScript library for fullscreen modals with sensible defaults.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/animated-modal.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/animated-modal.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EXIL/animatedModal.js.git"
  },
  "author": "EXIL <exil@kyrena.dev>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EXIL/animatedModal.js/issues"
  },
  "homepage": "https://github.com/EXIL/animatedModal.js#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && npm run build:css",
    "build:css": "node -e \"import fs from 'node:fs';import path from 'node:path';const dist=path.resolve('dist');fs.mkdirSync(dist,{recursive:true});fs.copyFileSync('src/styles/animated-modal.css',path.join(dist,'animated-modal.css'));\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^24.1.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
